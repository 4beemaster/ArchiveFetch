if(NOT DEFINED ROOT OR NOT DEFINED ASSET_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "ROOT, ASSET_DIR and OUTPUT are required")
endif()
set(files index.html app.css app-core.js app-library.js app-sources.js app-columns.js app-dialogs.js app-consoles.js app-main.js icon0.png startup-diagnostics.js)
set(types text/html text/css application/javascript application/javascript application/javascript application/javascript application/javascript application/javascript application/javascript image/png application/javascript)
set(content "#pragma once\n#include <cstddef>\nstruct EmbeddedAsset { const char* path; const unsigned char* data; std::size_t size; const char* type; };\n")
set(entries "")
set(index 0)
foreach(filename IN LISTS files)
    if(filename STREQUAL "icon0.png")
        file(READ "${ROOT}/ps5/icon0.png" bytes HEX)
    else()
        file(READ "${ROOT}/web/${filename}" bytes HEX)
    endif()
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
    list(GET types ${index} type)
    string(APPEND content "inline constexpr unsigned char asset_${index}[] = {${bytes}};\n")
    string(APPEND entries "{\"/${filename}\", asset_${index}, sizeof(asset_${index}), \"${type}\"},\n")
    math(EXPR index "${index}+1")
endforeach()
foreach(filename IN ITEMS Karla.ttf fa-solid-900.ttf Karla-OFL.txt Font-Awesome-LICENSE.txt cpp-httplib-LICENSE.txt nlohmann-json-LICENSE.txt qrcode.js qrcode-LICENSE.txt)
    file(READ "${ASSET_DIR}/${filename}" bytes HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
    set(type text/plain)
    if(filename MATCHES "\\.ttf$")
        set(type font/ttf)
    elseif(filename MATCHES "\\.js$")
        set(type application/javascript)
    endif()
    string(APPEND content "inline constexpr unsigned char asset_${index}[] = {${bytes}};\n")
    string(APPEND entries "{\"/assets/${filename}\", asset_${index}, sizeof(asset_${index}), \"${type}\"},\n")
    math(EXPR index "${index}+1")
endforeach()
string(APPEND content "inline constexpr EmbeddedAsset embedded_assets[] = {\n${entries}};\n")
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT}.tmp" "${content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")